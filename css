body {
    font-family: 'Segoe UI', sans-serif;
    margin: 40px auto;
    max-width: 900px;
    line-height: 1.7;
    color: #2c3e50;
}

h1 {
    font-size: 36px;
    border-bottom: 2px solid #2c3e50;
    padding-bottom: 10px;
}

h2 {
    margin-top: 30px;
    color: #1a5276;
}

h3 {
    margin-top: 20px;
    color: #34495e;
}

a {
    color: #1a5276;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

hr {
    margin: 30px 0;
}

ul {
    margin-left: 20px;
}

strong {
    color: #000;
}
